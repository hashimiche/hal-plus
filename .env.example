# HAL Plus — environment variables (copy to .env.local; all optional)

# --- Ollama -----------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:latest

# --- Retrieval backend ------------------------------------------------------
# local  = MiniSearch BM25 + Ollama embedding rerank (default, no extra services)
# qdrant = vector search against a pre-pushed Qdrant collection (falls back to
#          local automatically if Qdrant is unreachable or empty)
# HAL_RAG_BACKEND=local

# --- Qdrant (only used when HAL_RAG_BACKEND=qdrant) --------------------------
# HAL_QDRANT_URL=http://127.0.0.1:6333
# HAL_QDRANT_COLLECTION=hal-plus
# HAL_RAG_QDRANT_MIN_SCORE=0.4
# HAL_RAG_QDRANT_MAX_PER_PAGE=2

# --- Doc-search corpus (shared by both backends) ----------------------------
# HAL_DOC_SEARCH_EMBED_MODEL=nomic-embed-text
# HAL_DOC_SEARCH_CACHE_DIR=.hal-plus-cache/doc-search
